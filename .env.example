APP_NAME="NoteFlow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Recherche par similarité (NOTEFLOW_SEARCH=vector) : PostgreSQL avec
# pgvector, le service pgsql de compose.yaml. Décommentez ces lignes, puis
# relancez migrate:fresh --seed et noteflow:index.
# DB_CONNECTION=pgsql
# DB_HOST=pgsql
# DB_PORT=5432
# DB_DATABASE=noteflow
# DB_USERNAME=sail
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Configuration IA (TP S1.3) ---
# fake   = doublure, aucune requête réseau (valeur par défaut si la ligne est absente)
# ollama = modèle local, aucune clé nécessaire (valeur conseillée)
# http   = fournisseur en ligne compatible OpenAI (Mistral par défaut), demande une clé
#
# C'est la seule ligne à changer pour basculer d'un fournisseur à l'autre.
LLM_PROVIDER=ollama

# Fournisseur en ligne : utile seulement si LLM_PROVIDER=http
LLM_HTTP_API_KEY=
# LLM_HTTP_BASE_URL=https://api.mistral.ai/v1
# LLM_HTTP_MODEL=mistral-small-2603
# LLM_HTTP_TIMEOUT=30

# Ollama : les valeurs par défaut conviennent à une installation standard
# avec Docker Desktop.
# LLM_OLLAMA_HOST=http://host.docker.internal:11434
# LLM_OLLAMA_MODEL=llama3.2:3b
# LLM_OLLAMA_TIMEOUT=120
# Vide = valeur du serveur (OLLAMA_CONTEXT_LENGTH, réglée au chapitre 00).
# LLM_OLLAMA_CONTEXT_LENGTH=8192

# Version servie de chaque prompt (resources/prompts/<nom>/<version>.md)
# LLM_PROMPT_SUMMARIZE_NOTE=v1
# LLM_PROMPT_SUGGEST_TAGS=v1
# LLM_PROMPT_NOTE_AGENT=v1

# --- Agent NoteFlow (TP S2.4) ---
# Plafond d'étapes : nombre maximal d'appels au modèle pour une question.
# NOTEFLOW_AGENT_MAX_STEPS=5

# Recherche derrière chercher_notes : keyword (mots-clés, toute base) ou
# vector (similarité, PostgreSQL + pgvector, après noteflow:index).
# NOTEFLOW_SEARCH=keyword

# Vectorisation : même fournisseur que LLM_PROVIDER par défaut. Le modèle et
# la dimension vont ensemble (nomic-embed-text : 768, mistral-embed : 1024).
# Changer de modèle : migrate:fresh --seed, puis noteflow:index.
# LLM_EMBEDDING_PROVIDER=ollama
# LLM_EMBEDDING_OLLAMA_MODEL=nomic-embed-text
# LLM_EMBEDDING_HTTP_MODEL=mistral-embed
# LLM_EMBEDDING_DIMENSIONS=768

# Identifiants systeme utilises par les conteneurs Sail.
# Sous Linux/WSL, mettez le resultat de "id -u" et "id -g".
WWWUSER=1000
WWWGROUP=1000
